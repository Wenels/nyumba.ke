// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum ListingStatus {
  ACTIVE
  EXPIRED
  PENDING
  REMOVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}



enum BookingStatus {
  PENDING
  NEED_REVIEW
  VIEWING_SCHEDULED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
  LOCKED
}

enum PaymentScheduleStatus {
  UPCOMING
  DUE_SOON
  DUE_NOW
  OVERDUE
  PAID
}

enum IssuePriority {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssueReportedTo {
  LANDLORD
  ADMIN
}






model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  fullName      String
  role          Role     @default(TENANT)
  isAdmin       Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  verification  VerificationStatus @default(UNVERIFIED)
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings      Listing[]
  savedListings SavedListing[]
  sentMessages  Message[]      @relation("SentMessages")
  conversationsAsTenant   Conversation[] @relation("TenantConversations")
  conversationsAsLandlord Conversation[] @relation("LandlordConversations")
  reports       Report[]       @relation("ReportingUser")
  payments      Payment[]
  passwordResets PasswordReset[]
  verificationDocs VerificationDoc[]
  tenantBookings    Booking[]       @relation("TenantBookings")
  landlordBookings  Booking[]       @relation("LandlordBookings")
  tenantContracts   Contract[]      @relation("TenantContracts")
  landlordContracts Contract[]      @relation("LandlordContracts")
  tenantRentPayments  RentPayment[] @relation("TenantRentPayments")
  landlordRentPayments RentPayment[] @relation("LandlordRentPayments")
  tenantIssues      Issue[]         @relation("TenantIssues")
  landlordIssues    Issue[]         @relation("LandlordIssues")

}

model Listing {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  description   String
  price         Int
  bedrooms      Int
  bathrooms     Int
  propertyType  String
  latitude      Float
  longitude     Float
  address       String
  status        ListingStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  landlordId    String
  landlord      User          @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  photos        Photo[]
  savedBy       SavedListing[]
  conversations Conversation[]
  reports       Report[]
  bookings          Booking[]
  contracts         Contract[]
  issues            Issue[]
  amenities         Amenity[]
  conditionReport   ConditionReport?
}

model Photo {
  id        String  @id @default(uuid())
  url       String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
}

model SavedListing {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Conversation {
  id          String   @id @default(uuid())
  listingId   String
  tenantId    String
  landlordId  String
  createdAt   DateTime @default(now())

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant      User     @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord    User     @relation("LandlordConversations", fields: [landlordId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([listingId, tenantId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Report {
  id           String   @id @default(uuid())
  listingId    String
  reportedById String
  reason       String
  reportType   String   @default("OTHER")
  details      String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedBy   User     @relation("ReportingUser", fields: [reportedById], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  amount          Int
  phoneNumber     String
  status          PaymentStatus @default(PENDING)
  mpesaReceiptNo  String?
  checkoutRequestId String?     @unique
  purpose         String
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model VerificationDoc {
  id        String   @id @default(uuid())
  userId    String
  docType   String
  url       String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model Booking {
  id              String        @id @default(uuid())
  listingId       String
  tenantId        String
  landlordId      String
  unitType        String
  moveInDate      DateTime
  leaseDuration   Int           @default(12)
  viewingDate     DateTime?
  status          BookingStatus @default(PENDING)
  bookingFee      Int           @default(1000)
  feePaid         Boolean       @default(false)
  mpesaReceiptNo  String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant          User          @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord        User          @relation("LandlordBookings", fields: [landlordId], references: [id], onDelete: Cascade)
  contract        Contract?
}

model Contract {
  id              String         @id @default(uuid())
  bookingId       String         @unique
  listingId       String
  tenantId        String
  landlordId      String
  unitType        String
  monthlyRent     Int
  securityDeposit Int
  startDate       DateTime
  endDate         DateTime
  status          ContractStatus @default(PENDING)
  signedByTenant  Boolean        @default(false)
  signedByLandlord Boolean       @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing         Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant          User           @relation("TenantContracts", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord        User           @relation("LandlordContracts", fields: [landlordId], references: [id], onDelete: Cascade)
  rentPayments    RentPayment[]
}

model RentPayment {
  id              String                @id @default(uuid())
  contractId      String
  tenantId        String
  landlordId      String
  amount          Int
  dueDate         DateTime
  paidDate        DateTime?
  status          PaymentScheduleStatus @default(UPCOMING)
  mpesaReceiptNo  String?
  cycleNumber     Int
  createdAt       DateTime              @default(now())

  contract        Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant          User                  @relation("TenantRentPayments", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord        User                  @relation("LandlordRentPayments", fields: [landlordId], references: [id], onDelete: Cascade)
}

model Issue {
  id              String          @id @default(uuid())
  listingId       String
  tenantId        String
  landlordId      String
  category        String
  subject         String
  description     String
  priority        IssuePriority   @default(MODERATE)
  status          IssueStatus     @default(OPEN)
  reportedTo      IssueReportedTo @default(LANDLORD)
  resolvedAt      DateTime?
  photos          IssuePhoto[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  listing         Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant          User            @relation("TenantIssues", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord        User            @relation("LandlordIssues", fields: [landlordId], references: [id], onDelete: Cascade)
}

model IssuePhoto {
  id        String   @id @default(uuid())
  issueId   String
  url       String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Amenity {
  id        String   @id @default(uuid())
  listingId String
  name      String
  available Boolean  @default(true)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ConditionReport {
  id          String   @id @default(uuid())
  listingId   String   @unique
  floors      Json
  utilities   Json
  walls       Json
  allPassed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
